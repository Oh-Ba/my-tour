# Copy this file to .env and fill in the values. .env is not committed.

# Required for the AI guide (place stories, photo stories, free-text interests).
# Create a key at https://platform.claude.com/
ANTHROPIC_API_KEY=

# Optional: the Claude model the guide uses (default: claude-opus-5-5).
# GUIDE_MODEL=claude-opus-5-5

# Optional: where places come from. "osm" (real places worldwide, the default)
# or "fixtures" (the bundled San Francisco sample data, no network needed).
# POI_PROVIDER=osm

# Optional: your own Overpass server(s), comma-separated, instead of the
# public mirrors.
# OVERPASS_URL=https://overpass.example.com/api/interpreter

# PORT=1402

# Developer mode. Set a long random secret to switch on the /dev routes used
# for recording other guides, adding photos and teaching the style. Leave it
# unset on any server ordinary users reach. Build the app with the same value:
#   flutter run --dart-define=DEV_MODE=true --dart-define=DEV_TOKEN=<this value>
# DEV_TOKEN=

# Where what the developer teaches is kept (default: server/data).
# DATA_DIR=

# Speech-to-text for developer mode: turns recordings of guides into text.
# Create a key at https://platform.openai.com/api-keys (about $1 per 3 hours
# of audio). Without it, recordings are kept and wait.
# OPENAI_API_KEY=
# Optional: the transcription model (default: whisper-1).
# STT_MODEL=whisper-1
